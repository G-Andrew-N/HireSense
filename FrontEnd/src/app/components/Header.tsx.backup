import { Bell, Search, Loader2 } from "lucide-react";
import { Input } from "./ui/input";
import { Button } from "./ui/button";
import { ThemeToggle } from "./ThemeToggle";
import { useNavigate } from "react-router";
import { useScan } from "../../lib/scan-context";
import { useNotification } from "../../lib/notification-context";
import { useState, useEffect } from "react";
import { apiRequest } from "../../lib/api";

interface HeaderProps {
  title: string;
  subtitle?: string;
  showSearch?: boolean;
}

interface AdminNotification {
  id: number;
  is_read: boolean;
}

export function Header({ title, subtitle, showSearch = false }: HeaderProps) {
  const navigate = useNavigate();
  const [adminUnreadCount, setAdminUnreadCount] = useState(0);
  
  // Get app notifications unread count
  let appUnreadCount = 0;
  try {
    const { notifications } = useNotification();
    appUnreadCount = notifications.filter(n => !n.read).length;
  } catch {
    // Not inside notification provider, ignore
  }

  // Fetch admin notifications unread count
  useEffect(() => {
    const fetchAdminUnreadCount = async () => {
      try {
        const response = await apiRequest<{ results: AdminNotification[] }>('/notifications/');
        const unreadCount = (response.results || []).filter(n => !n.is_read).length;
        setAdminUnreadCount(unreadCount);
      } catch (error) {
        // Silently fail - user might not be logged in or endpoint not available
      }
    };

    fetchAdminUnreadCount();
    // Refresh every 60 seconds
    const interval = setInterval(fetchAdminUnreadCount, 60000);
    return () => clearInterval(interval);
  }, []);

  const totalUnreadCount = appUnreadCount + adminUnreadCount
interface HeaderProps {
  title: string;
  subtitle?: string;
  showSearch?: boolean;
}

export function Header({ title, subtitle, showSearch = false }: HeaderProps) {
  const navigate = useNavigate();
  const [adminUnreadCount, setAdminUnreadCount] = useState(0);
  
  // Get app notifications unread count
  let appUnreadCount = 0;
  try {
    const { notifications } = useNotification();
    appUnreadCount = notifications.filter(n => !n.read).length;
  } catch {
    // Not in notification context
  }

  // Fetch admin notifications unread count
  useEffect(() => {
    const fetchAdminUnread = async () => {
      try {
        const response = await apiRequest<{ results: AdminNotification[] }>('/notifications/');
        const unreadCount = response.results?.filter(n => !n.is_read).length || 0;
        setAdminUnreadCount(unreadCount);
      } catch {
        // Ignore errors (user might not be logged in)
      }
    };
    
    fetchAdminUnread();
    // Refresh every 30 seconds
    const interval = setInterval(fetchAdminUnread, 30000);
    return () => clearInterval(interval);
  }, []);

  const totalUnread = appUnreadCount + adminUnreadCount;

  return (
    <div className="flex flex-col sm:flex-row sm:items-center justify-between px-4 sm:px-6 lg:px-8 py-4 sm:py-6 bg-white dark:bg-gray-900 border-b border-gray-200 dark:border-gray-800 gap-4">
      <div>
        <h1 className="text-xl sm:text-2xl font-semibold text-gray-900 dark:text-gray-100">{title}</h1>
        {subtitle && <p className="text-sm text-gray-500 dark:text-gray-400 mt-1">{subtitle}</p>}
      </div>
      
      <div className="flex items-center gap-2 sm:gap-4">
        {/* Global scanning indicator */}
        {(() => {
          try {
            const scan = useScan();
            if (scan.isScanning) {
              return (
                <div className="hidden sm:flex items-center gap-2 px-3 py-1 bg-emerald-50 dark:bg-emerald-900 text-emerald-700 dark:text-emerald-300 rounded-full text-xs">
                  <Loader2 className="w-4 h-4 animate-spin" />
                  <span>Scanning</span>
                </div>
              );
            }
          } catch {
            /* ignore when not inside provider */
          }
          return null;
        })()}
        {showSearch && (
          <div className="relative flex-1 sm:flex-initial sm:w-64 lg:w-80">
            <Search className="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" />
            <Input 
              placeholder="Search jobs..." 
              className="pl-10 bg-gray-50 dark:bg-gray-800 border-gray-200 dark:border-gray-700"
            />
          </div>
        )}
        
        <ThemeToggle className="hidden lg:flex" />
        
        <Button 
          variant="ghost" 
          size="icon" 
          className="relative flex-shrink-0 hidden lg:flex"
          onClick={() => navigate("/dashboard/notifications")}
        >
          {totalUnreadCount > 0 ? (
            <>
              <Bell className="w-5 h-5 text-blue-600 dark:text-blue-400 fill-blue-600 dark:fill-blue-400" />
              {totalUnreadCount > 0 && (
                <span className="absolute -top-1 -right-1 flex items-center justify-center min-w-[18px] h-[18px] px-1 bg-red-600 text-white text-[10px] font-bold rounded-full">
                  {totalUnreadCount > 99 ? '99+' : totalUnreadCount}
                </span>
              )}
            </>
          ) : (
            <Bell className="w-5 h-5 text-gray-600 dark:text-gray-400" />
          )}
        </Button>
      </div>
    </div>
  );
}