# Django
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (optional; defaults to SQLite if not set)
# DATABASE_URL=postgresql://user:password@localhost:5432/hiresense
DATABASE_URL=

# Celery & Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Cache (optional)
CACHE_URL=

# CORS (frontend origin)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email
EMAIL_BACKEND=
DEFAULT_FROM_EMAIL=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=

# Gmail SMTP (example)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DEFAULT_FROM_EMAIL=HireSense <your_gmail@gmail.com>
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your_gmail@gmail.com
# EMAIL_HOST_PASSWORD=your_16_char_app_password
# EMAIL_USE_TLS=True

# Frontend base URL (used in password reset links)
FRONTEND_URL=http://localhost:5173

# AI / LLM: openai | gemini | groq
AI_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Cloudinary (for media storage in production)
